{
  "name": "the-system",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "THE SYSTEM - a Solo Leveling themed life-gamification PWA",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "icons": "pwa-assets-generator",
    "gen:sql": "node scripts/gen-sql-artifacts.mjs",
    "db:sql": "node scripts/local-sql.mjs",
    "db:verify": "node scripts/local-sql.mjs supabase/tests/game_date_parity.sql supabase/tests/quest_schedule_parity.sql supabase/tests/safe_zone_parity.sql supabase/tests/penalty_parity.sql supabase/tests/rls_proof.sql supabase/tests/smoke_game_rules.sql supabase/tests/smoke_safe_zones.sql supabase/tests/smoke_penalty_zone.sql",
    "sim:days": "node scripts/local-sql.mjs supabase/dev/simulate_days.sql"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@supabase/supabase-js": "^2.119.2",
    "@tanstack/react-query": "^5.108.3",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  }
}
